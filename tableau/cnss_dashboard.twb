      <column caption='Annee' datatype='integer' name='[ANNEE]' role='measure' type='quantitative' />
      <column caption='Credit Cnss' datatype='real' name='[CREDIT_CNSS]' role='measure' type='quantitative' />
      <column caption='Credit Tfp' datatype='real' name='[CREDIT_TFP]' role='measure' type='quantitative' />
      <column caption='Nombre d&apos;Assurés' datatype='integer' name='[Calculation_0157002799837190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([IMMA_NUM])' />
      </column>
      <column caption='Date Mensuelle' datatype='datetime' name='[Calculation_0157002817753095]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPARSE(&quot;yyyyMM&quot;, STR([PERIODE (tableau_payment.csv)]))' />
      </column>
      <column caption='Masse Salariale' datatype='real' default-format='n#,##0,,.00M&quot; DH&quot;;-#,##0,,.00M&quot; DH&quot;' name='[Calculation_0157002842017801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SALAIRE_BRUT])' />
      </column>
      <column caption='Salaire Moyen' datatype='real' default-format='c#,##0.00&quot; MAD / mois&quot;;(#,##0.00&quot; MAD / mois&quot;)' name='[Calculation_0157002842152970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SALAIRE_BRUT]) / COUNT([IMMA_NUM])' />
      </column>
      <column caption='Taille_Affilie' datatype='integer' name='[Calculation_0157002849845259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([AFF_NUM])' />
      </column>
      <column caption='Cotisation Due Ligne' datatype='real' default-format='c#,##0,,.0M&quot;DH&quot;;(#,##0,,.0M&quot;DH&quot;)' name='[Calculation_0335670948098050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([DEBIT_CNSS]) + ZN([DEBIT_AMO]) + ZN([DEBIT_TFP])' />
      </column>
      <column caption='Cotisation Payée Ligne' datatype='real' default-format='c#,##0,,.0M&quot;DH&quot;;(#,##0,,.0M&quot;DH&quot;)' name='[Calculation_0335670948290563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([CREDIT_CNSS]) + ZN([CREDIT_TFP])' />
      </column>
      <column caption='Pénalités Ligne' datatype='real' default-format='c#,##0,.0K&quot; DH&quot;;(#,##0,.0K&quot; DH&quot;)' name='[Calculation_0335670948392964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([PN_CNSS]) + ZN([PN_TFP])' />
      </column>
      <column caption='Reste à recouvrer' datatype='real' default-format='c#,##0,,.0M&quot; DH&quot;;(#,##0,,.0M&quot; DH&quot;)' name='[Calculation_0335670949335045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0335670948098050]) + SUM([Calculation_0335670948392964]) - SUM([Calculation_0335670948290563])' />
      </column>
      <column caption='Taux de recouvrement' datatype='real' default-format='p0.0%' name='[Calculation_0335670949572614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0335670948290563]) / SUM([Calculation_0335670948098050])' />
      </column>
      <column caption='Ancienneté Affilié (Années)' datatype='integer' name='[Calculation_0704010196336653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [DATE_AFFILIATION], #2024-12-31#)' />
      </column>
      <column caption='Statut Solvabilité' datatype='string' name='[Calculation_0704010196463630]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0335670949572614] &gt;= 0.95 THEN &quot;SITUATION SAINE&quot;&#13;&#10;ELSEIF [Calculation_0335670949572614] &gt;= 0.80 THEN &quot;VIGILANCE&quot;&#13;&#10;ELSE &quot;DÉBITEUR CRITIQUE&quot;&#13;&#10;END' />
      </column>
      <column caption='Secteur Taux Recouvrement' datatype='real' default-format='p0.00%' name='[Calculation_0704010196557839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [LIBELLE_SECTEUR] : &#13;&#10;  SUM([Calculation_0335670948290563]) / SUM([Calculation_0335670948098050]) &#13;&#10;}' />
      </column>
      <column caption='Secteur Salaire Moyen' datatype='real' name='[Calculation_0704010196639760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [LIBELLE_SECTEUR] : &#13;&#10;  SUM([SALAIRE_BRUT]) / COUNT([IMMA_NUM]) &#13;&#10;}' />
      </column>
      <column caption='Secteur Effectif Moyen' datatype='real' default-format='N' name='[Calculation_0704010196721681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [LIBELLE_SECTEUR] : &#13;&#10;  AVG({ FIXED [AFF_NUM], [LIBELLE_SECTEUR] : COUNTD([IMMA_NUM]) }) &#13;&#10;}' />
      </column>
      <column caption='Indicateur' datatype='string' name='[Calculation_0704010217848850]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;1. Taux Recouvrement (%)&quot;' />
      </column>
      <column caption='Gain simulé' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_AffGain]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0335670949335045]*[Parameters].[D3_Recovery]' />
      </column>
      <column caption='Dette résiduelle' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_AffRemain]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0335670949335045]-[D3_AffGain]' />
      </column>
      <column caption='Assurés estimés' datatype='real' default-format='n#,##0' name='[D3_AffSocial]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([Calculation_0157002799837190]*[Parameters].[D3_Recovery],0)' />
      </column>
      <column caption='Impact Trésorerie Simulé' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_Cash]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([D3_TopDebt])*[Parameters].[D3_Recovery]' />
      </column>
      <column caption='Dette nette — ligne' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_DebtRow]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0335670948098050]+[Calculation_0335670948392964]-[Calculation_0335670948290563]' />
      </column>
      <column caption='Trésorerie actuelle' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_InitialCash]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0335670948290563])' />
      </column>
      <column caption='Taux initial' datatype='real' default-format='p0.0%' name='[D3_InitialRate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0335670948290563])/SUM([Calculation_0335670948098050])' />
      </column>
      <column caption='Encaissement après remise (variante)' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_NetCash]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[D3_Cash]-[D3_PenaltyRelief]*[Parameters].[D3_Recovery]' />
      </column>
      <column caption='Remise potentielle sur pénalités' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_PenaltyRelief]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([D3_TopPenalties])*[Parameters].[D3_Relief]' />
      </column>
      <column caption='Gain en points' datatype='real' default-format='n+0.0&quot; pt&quot;;-0.0&quot; pt&quot;' name='[D3_Points]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([D3_Rate]-SUM([Calculation_0335670948290563])/SUM([Calculation_0335670948098050]))*100' />
      </column>
      <column caption='Nouveau Taux Recouvrement %' datatype='real' default-format='p0.0%' name='[D3_Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_0335670948098050])&lt;&gt;0 THEN (SUM([Calculation_0335670948290563])+[D3_Cash])/SUM([Calculation_0335670948098050]) END' />
      </column>
      <column caption='Nouveau Reste Dû Top 10' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_Remain]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([D3_TopDebt])-[D3_Cash]' />
      </column>
      <column caption='Assurés Régularisés (Impact Social)' datatype='real' default-format='n#,##0' name='[D3_Social]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(MIN([D3_TopWorkers])*[Parameters].[D3_Recovery],0)' />
      </column>
      <column caption='Reste Dû Top 10' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_TopDebt]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF [D3_Top10] THEN [D3_DebtRow] END) }' />
      </column>
      <column caption='Pénalités Top 10' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_TopPenalties]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF [D3_Top10] THEN [Calculation_0335670948392964] END) }' />
      </column>
      <column caption='Salariés Top 10' datatype='integer' default-format='n#,##0' name='[D3_TopWorkers]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD(IF [D3_Top10] THEN [IMMA_NUM] END) }' />
      </column>
      <column caption='Trésorerie simulée' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_TotalCash]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0335670948290563])+[D3_Cash]' />
