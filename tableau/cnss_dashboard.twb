      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CNSS — Simulation What-If' name='federated.d3simulation20260927' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Param % Recouvrement Impayés' datatype='real' default-format='p0.0%' name='[D3_Recovery]' param-domain-type='range' role='measure' type='quantitative' value='0.30000000000000004'>
              <calculation class='tableau' formula='0.30000000000000004' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.d3simulation20260927'>
            <column caption='Aff Num' datatype='string' name='[AFF_NUM]' role='dimension' type='nominal' />
            <column caption='Credit Cnss' datatype='real' name='[CREDIT_CNSS]' role='measure' type='quantitative' />
            <column caption='Credit Tfp' datatype='real' name='[CREDIT_TFP]' role='measure' type='quantitative' />
            <column caption='Nombre d&apos;Assurés' datatype='integer' name='[Calculation_0157002799837190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([IMMA_NUM])' />
            </column>
            <column caption='Cotisation Due Ligne' datatype='real' default-format='c#,##0,,.0M&quot;DH&quot;;(#,##0,,.0M&quot;DH&quot;)' name='[Calculation_0335670948098050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([DEBIT_CNSS]) + ZN([DEBIT_AMO]) + ZN([DEBIT_TFP])' />
            </column>
            <column caption='Cotisation Payée Ligne' datatype='real' default-format='c#,##0,,.0M&quot;DH&quot;;(#,##0,,.0M&quot;DH&quot;)' name='[Calculation_0335670948290563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([CREDIT_CNSS]) + ZN([CREDIT_TFP])' />
            </column>
            <column caption='Pénalités Ligne' datatype='real' default-format='c#,##0,.0K&quot; DH&quot;;(#,##0,.0K&quot; DH&quot;)' name='[Calculation_0335670948392964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([PN_CNSS]) + ZN([PN_TFP])' />
            </column>
            <column caption='Reste à recouvrer' datatype='real' default-format='c#,##0,,.0M&quot; DH&quot;;(#,##0,,.0M&quot; DH&quot;)' name='[Calculation_0335670949335045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0335670948098050]) + SUM([Calculation_0335670948392964]) - SUM([Calculation_0335670948290563])' />
            </column>
            <column caption='Gain simulé' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_AffGain]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0335670949335045]*[Parameters].[D3_Recovery]' />
            </column>
            <column caption='Dette résiduelle' datatype='real' default-format='n#,##0,,.00&quot; M MAD&quot;;-#,##0,,.00&quot; M MAD&quot;' name='[D3_AffRemain]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0335670949335045]-[D3_AffGain]' />
            </column>
            <column caption='Assurés estimés' datatype='real' default-format='n#,##0' name='[D3_AffSocial]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_0157002799837190]*[Parameters].[D3_Recovery],0)' />
            </column>
            <column caption='Debit Amo' datatype='real' name='[DEBIT_AMO]' role='measure' type='quantitative' />
            <column caption='Debit Cnss' datatype='real' name='[DEBIT_CNSS]' role='measure' type='quantitative' />
            <column caption='Debit Tfp' datatype='real' name='[DEBIT_TFP]' role='measure' type='quantitative' />
            <column caption='Imma Num' datatype='string' name='[IMMA_NUM]' role='dimension' type='nominal' />
            <column caption='Pn Cnss' datatype='real' name='[PN_CNSS]' role='measure' type='quantitative' />
